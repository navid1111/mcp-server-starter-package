{
  "name": "mcp-server-starter",
  "version": "0.1.0",
  "description": "Scaffold a ready-to-run Model Context Protocol (MCP) server with a single command",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "scaffold",
    "cli",
    "generator"
  ],
  "author": "navid1111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/navid1111/mcp-server-starter-package.git"
  },
  "bugs": {
    "url": "https://github.com/navid1111/mcp-server-starter-package/issues"
  },
  "homepage": "https://github.com/navid1111/mcp-server-starter-package#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "bin": {
    "mcp-server-starter": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "tsd",
    "test:contract": "jest --config jest.contract.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "openai": "^6.8.1",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsd": "^0.30.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
